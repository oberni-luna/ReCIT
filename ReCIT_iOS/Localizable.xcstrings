    "about.tagline" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "inventaire.io is a shared library, free and without ads. Ex-libris keeps your books there."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "inventaire.io est une bibliothèque commune, libre et sans publicité. Ex-libris y range vos livres."
          }
        }
      }
    },
    "about.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À propos"
          }
        }
      }
    },
    "about.value.account.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same sign-in, same books: everything you shelve here is on inventaire.io, and the other way round."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mêmes identifiants, mêmes livres : tout ce que vous rangez ici se retrouve sur inventaire.io, et inversement."
          }
        }
      }
    },
    "about.value.account.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account is an inventaire.io account"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte est un compte inventaire.io"
          }
        }
      }
    },
    "about.value.commons.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone lists their books there and chooses who sees them: their friends, their groups, or everyone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun y inventorie ses livres et choisit qui les voit : ses amis, ses groupes, ou tout le monde."
          }
        }
      }
    },
    "about.value.commons.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shared library"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une bibliothèque commune"
          }
        }
      }
    },
    "about.value.data.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titles, authors and editions join a free database, linked to Wikidata, that anyone can reuse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titres, auteur·ices et éditions rejoignent une base libre, reliée à Wikidata, que chacun peut réutiliser."
          }
        }
      }
    },
    "about.value.data.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open data"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des données ouvertes"
          }
        }
      }
    },
    "about.value.software.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its code is public, it sells nothing about you, and it lives on donations from the people who use it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son code est public, il ne revend rien de vous, et il vit des dons de celles et ceux qui l’utilisent."
          }
        }
      }
    },
    "about.value.software.title" : {
      "localizations" : {
