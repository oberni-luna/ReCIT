    "create_book.failure.network.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "inventaire.io did not answer. Nothing was created there, and nothing is lost here: what you wrote is kept, and trying again makes no duplicate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "inventaire.io n’a pas répondu. Rien n’a été créé là-bas, et rien n’est perdu ici : ce que vous avez écrit est gardé, et réessayer ne fait pas de doublon."
          }
        }
      }
    },
