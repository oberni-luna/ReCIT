    "edit_author.databases.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ISNI, BnF, IdRef, Babelio, ORCID, Goodreads, NooSFere, BD Gest’… twenty-nine catalogues in all. Swipe an identifier to remove it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ISNI, BnF, IdRef, Babelio, ORCID, Goodreads, NooSFere, BD Gest’… vingt-neuf bases en tout. Glissez un identifiant pour le retirer."
          }
        }
      }
    },
    "edit_author.general.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A year alone is enough for a date. What you change here applies to all their works. Swipe a pseudonym to remove it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une année seule suffit pour les dates. Ce que vous changez ici vaut pour toutes ses œuvres. Glissez un pseudonyme pour le retirer."
          }
        }
      }
    },
