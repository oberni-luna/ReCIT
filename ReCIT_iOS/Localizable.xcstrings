    "groups.delete.confirm.message %lld" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The group will disappear from inventaire.io. This cannot be undone."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Its member will be removed, then the group will disappear from inventaire.io. This cannot be undone."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Its %lld members will be removed, then the group will disappear from inventaire.io. This cannot be undone."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Le groupe disparaîtra d’inventaire.io. Impossible de revenir en arrière."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Son membre en sera retiré, puis le groupe disparaîtra d’inventaire.io. Impossible de revenir en arrière."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ses %lld membres en seront retirés, puis le groupe disparaîtra d’inventaire.io. Impossible de revenir en arrière."
                }
              }
            }
          }
        }
      }
    },
