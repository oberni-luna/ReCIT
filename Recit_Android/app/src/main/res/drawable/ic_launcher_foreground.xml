<?xml version="1.0" encoding="utf-8"?>
<!--
    The books-on-a-shelf illustration of ReCIT_iOS/Resources/AppIcon.icon. iOS draws it at 75 % of
    the tile, lifted by 20.75 / 1024; an adaptive icon shows only the middle 72 of its 108 dp, so
    the art takes half the canvas, centred, and rides up by the same share.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_art"
    android:insetLeft="25%"
    android:insetRight="25%"
    android:insetTop="23.6%"
    android:insetBottom="26.4%" />
