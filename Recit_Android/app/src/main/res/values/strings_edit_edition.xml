    <string name="edit_edition_failure_refused_title">inventaire.io a refusé cette modification</string>
    <string name="edit_edition_failure_refused_body">Le titre ou la couverture ne sont peut-être pas acceptés tels quels — cette édition peut aussi être modifiée sur inventaire.io même.</string>
    <string name="edit_edition_failure_network_title">L’enregistrement n’est pas passé</string>
    <string name="edit_edition_failure_network_body">inventaire.io n’a pas répondu. Ce que vous avez écrit est gardé ici, et réessayer n’envoie que ce qui n’est pas passé.</string>

