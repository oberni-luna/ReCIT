<?xml version="1.0" encoding="utf-8"?>
<!--
  « Modifier l'édition » and the pages it pushes (iOS features 0049, 0050; issue 0144). French values of
  ReCIT_iOS/Localizable.xcstrings (edit_edition.*, edit_work.*, edition_property.*, edition_format.*,
  entity_picker.*, and the create_book.* the form shares with the scanner's « Nouvelle édition »), keys
  with '.' turned into '_'. The edition_property_* names are the ones EditionProperty.labelKey gives.
  edition_property_names_and is Android's own: the « et » of a list of names, which iOS formats itself.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The form -->
    <string name="edit_edition_title">Modifier l’édition</string>
    <string name="edit_edition_title_header">Titre</string>
    <string name="edit_edition_subtitle_field">Sous-titre de cette édition</string>
    <string name="edit_edition_cover_header">Couverture et ISBN</string>
    <string name="edit_edition_cover_footer">Touchez la couverture pour la remplacer ou la retirer. L’ISBN ne se change pas d’ici : c’est par lui que le livre est retrouvé au scan.</string>
    <string name="edit_edition_isbn">ISBN</string>
    <string name="edit_edition_isbn10">ISBN-10</string>
    <string name="edit_edition_isbn13">ISBN-13</string>
    <string name="edit_edition_remove">Retirer</string>

    <string name="edit_edition_works_add">Ajouter une œuvre</string>
    <string name="edit_edition_works_detach">Détacher</string>
    <string name="edit_edition_works_empty_help">Une édition est celle d’une œuvre au moins : ajoutez-en une pour pouvoir enregistrer.</string>
    <string name="edit_edition_works_help">Touchez une œuvre pour la modifier. Glissez-la vers la gauche pour la détacher de cette édition. Un recueil en réunit plusieurs.</string>
    <string name="edit_edition_works_new_help">Touchez la nouvelle œuvre pour lui donner un·e auteur·ice : elle ne se crée pas sans.</string>
    <string name="edit_edition_work_add_author">Ajouter un·e auteur·ice</string>
    <string name="edit_edition_work_new_author">Créé·e sur inventaire.io à l’enregistrement</string>
    <string name="edit_edition_work_search_empty_title">De quelle œuvre est-ce une édition ?</string>
    <string name="edit_edition_work_search_empty_message">Cherchez son titre ou son auteur·ice. Si l’œuvre n’est pas sur inventaire.io, vous pourrez la créer.</string>

    <string name="edit_edition_publication_header">Publication</string>
    <string name="edit_edition_publication_footer">Maison d’édition et collection se choisissent parmi celles d’inventaire.io, ou se créent. Une année seule suffit pour la date.</string>
    <string name="edit_edition_format_header">Format</string>
    <string name="edit_edition_format_footer">Broché, relié, poche, album, livre numérique ou livre audio.</string>
    <string name="edit_edition_contributors_header">Ont aussi fait cette édition</string>
    <string name="edit_edition_contributors_footer">Les auteur·ices de l’œuvre sont dans « Édition de ». Ici, celles et ceux qui ont fait cette édition-ci. Chaque rôle peut en nommer plusieurs.</string>
    <string name="edit_edition_databases_header">Bases bibliographiques</string>
    <string name="edit_edition_databases_footer">BnF, Open Library, SUDOC, VIAF… vingt-deux bases en tout. Glissez un identifiant pour le retirer.</string>
    <string name="edit_edition_databases_add">Ajouter un identifiant</string>
    <string name="edit_edition_links_header">Sur le web</string>
    <string name="edit_edition_links_footer">Site officiel, blog, réseaux sociaux. Glissez un lien pour le retirer.</string>
    <string name="edit_edition_links_add">Ajouter un lien</string>

