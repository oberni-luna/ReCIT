    <!-- À propos d'inventaire.io (feature 0034) -->
    <string name="about_title">À propos</string>
    <string name="about_headline">La bibliothèque derrière Ex-libris</string>
    <string name="about_tagline">inventaire.io est une bibliothèque commune, libre et sans publicité. Ex-libris y range vos livres.</string>
    <string name="about_value_commons_title">Une bibliothèque commune</string>
    <string name="about_value_commons_body">Chacun y inventorie ses livres et choisit qui les voit : ses amis, ses groupes, ou tout le monde.</string>
    <string name="about_value_account_title">Votre compte est un compte inventaire.io</string>
    <string name="about_value_account_body">Mêmes identifiants, mêmes livres : tout ce que vous rangez ici se retrouve sur inventaire.io, et inversement.</string>
    <string name="about_value_data_title">Des données ouvertes</string>
    <string name="about_value_data_body">Titres, auteur·ices et éditions rejoignent une base libre, reliée à Wikidata, que chacun peut réutiliser.</string>
    <string name="about_value_software_title">Un logiciel libre, sans publicité</string>
    <string name="about_value_software_body">Son code est public, il ne revend rien de vous, et il vit des dons de celles et ceux qui l’utilisent.</string>
    <string name="about_links">Aller plus loin</string>
    <string name="about_link_website">Visiter inventaire.io</string>
    <string name="about_link_data">Explorer les données ouvertes</string>
    <string name="about_link_source">Lire le code source</string>
    <string name="about_link_donate">Soutenir inventaire.io</string>
    <string name="about_independence">Ex-libris est une app indépendante : elle s’appuie sur l’API publique d’inventaire.io.</string>

    <!-- Deleting the account (feature 0017) -->
    <string name="delete_account_title">Supprimer mon compte</string>
    <string name="delete_account_intro">Cette action est définitive. En supprimant votre compte :</string>
    <string name="delete_account_empty">Votre compte et tout ce qu\'il contient seront supprimés.</string>
    <plurals name="delete_account_line_books">
