# Copy to .env to change a setting: docker compose reads it. The defaults below need no copy.
POSTGRES_DB=exlibris
POSTGRES_USER=exlibris
POSTGRES_PASSWORD=exlibris

# `./gradlew run` reads its own environment instead, with the same defaults:
# DATABASE_URL=jdbc:postgresql://localhost:5432/exlibris
# DATABASE_USER=exlibris
# DATABASE_PASSWORD=exlibris
# PORT=8080
