# Copy to .env to change a setting: docker compose reads it. The defaults below need no copy.
POSTGRES_DB=exlibris
POSTGRES_USER=exlibris
POSTGRES_PASSWORD=exlibris

# `./gradlew run` reads its own environment instead, with the same defaults:
# DATABASE_URL=jdbc:postgresql://localhost:5432/exlibris
# DATABASE_USER=exlibris
# DATABASE_PASSWORD=exlibris
# PORT=8080

# Sessions and e-mails. Defaults work with `docker compose up db mail` and a local backend.
# SESSION_SECRET=newest-secret,previous-secret   # comma-separated, newest first; required behind HTTPS
# PUBLIC_BASE_URL=http://localhost:8080          # what the e-mails' links open; https makes cookies Secure
# SMTP_HOST=localhost                            # Mailpit; its inbox is http://localhost:8025
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
# MAIL_FROM=Ex-libris <no-reply@exlibris.localhost>

