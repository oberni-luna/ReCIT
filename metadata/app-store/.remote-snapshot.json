  "app_store_version_localizations": [
    {
      "attributes": {
        "description": "Welcome to Inventaire.io \u2014 the app that turns your friends into a living library!\n\nWith Inventaire.io you can:\n\u2022 Build your book inventory in seconds\n\u2022 Explore the libraries of your friends and the groups you belong to\n\u2022 Borrow, lend and share your favorite reads\n\u2022 Search for any book in a snap\n\nOur mission: spread reading around you and give books back their power to bring people together.\n\nInventaire.io is the official mobile client of the free and collaborative inventaire.io project. Join a kind community of passionate readers!",
        "keywords": "books,reading,library,borrow,lend,inventory,share,friends,readers,comics",
        "locale": "en-US",
        "marketingUrl": "https://inventaire.io/",
        "promotionalText": "Borrow, lend and organize books with your community of readers. Inventaire.io turns your friends into one big living library.",
        "supportUrl": "https://inventaire.io/",
        "whatsNew": null
      },
